NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

# Contact form (Resend + reCAPTCHA v3)
RESEND_API_KEY="<paste your Resend API key here>" # Required - use a sending-only key scoped to naturesportrait.ca in production
CONTACT_FORM_TO="" # Required - inbox that receives contact form messages
CONTACT_FORM_FROM="" # Optional - defaults to "Nature's Portrait <contact@naturesportrait.ca>" (must be on a domain verified in Resend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="" # Required - reCAPTCHA v3 site key
RECAPTCHA_SECRET_KEY="" # Required - reCAPTCHA v3 secret key
